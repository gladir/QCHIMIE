# Optimisation de la cellule d'un cristal d'argon cfc (potentiel de Lennard-Jones)
# La maille part de 5,0 angstroms et se relaxe vers la pression exterieure de 0 bar
&GLOBAL
  PROJECT ARCELL
  RUN_TYPE CELL_OPT
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD FIST
  &MM
    &FORCEFIELD
      &CHARGE
        ATOM Ar
        CHARGE 0.0
      &END CHARGE
      &NONBONDED
        &LENNARD-JONES
          ATOMS Ar Ar
          EPSILON [K_e] 119.8
          SIGMA [angstrom] 3.405
          RCUT [angstrom] 4.9
        &END LENNARD-JONES
      &END NONBONDED
    &END FORCEFIELD
    &POISSON
      &EWALD
        EWALD_TYPE NONE
      &END EWALD
    &END POISSON
  &END MM
  &SUBSYS
    &CELL
      ABC [angstrom] 10.0 10.0 10.0
    &END CELL
    &COORD
      Ar 0.000000 0.000000 0.000000
      Ar 2.500000 2.500000 0.000000
      Ar 2.500000 0.000000 2.500000
      Ar 0.000000 2.500000 2.500000
      Ar 0.000000 0.000000 5.000000
      Ar 2.500000 2.500000 5.000000
      Ar 2.500000 0.000000 7.500000
      Ar 0.000000 2.500000 7.500000
      Ar 0.000000 5.000000 0.000000
      Ar 2.500000 7.500000 0.000000
      Ar 2.500000 5.000000 2.500000
      Ar 0.000000 7.500000 2.500000
      Ar 0.000000 5.000000 5.000000
      Ar 2.500000 7.500000 5.000000
      Ar 2.500000 5.000000 7.500000
      Ar 0.000000 7.500000 7.500000
      Ar 5.000000 0.000000 0.000000
      Ar 7.500000 2.500000 0.000000
      Ar 7.500000 0.000000 2.500000
      Ar 5.000000 2.500000 2.500000
      Ar 5.000000 0.000000 5.000000
      Ar 7.500000 2.500000 5.000000
      Ar 7.500000 0.000000 7.500000
      Ar 5.000000 2.500000 7.500000
      Ar 5.000000 5.000000 0.000000
      Ar 7.500000 7.500000 0.000000
      Ar 7.500000 5.000000 2.500000
      Ar 5.000000 7.500000 2.500000
      Ar 5.000000 5.000000 5.000000
      Ar 7.500000 7.500000 5.000000
      Ar 7.500000 5.000000 7.500000
      Ar 5.000000 7.500000 7.500000
    &END COORD
    &KIND Ar
      ELEMENT Ar
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
&MOTION
  &CELL_OPT
    OPTIMIZER BFGS
    EXTERNAL_PRESSURE [bar] 0.0
    PRESSURE_TOLERANCE [bar] 10.0
    MAX_ITER 100
    MAX_DR 1.0E-4
    RMS_DR 5.0E-5
    MAX_FORCE 1.0E-5
    RMS_FORCE 5.0E-6
  &END CELL_OPT
&END MOTION
