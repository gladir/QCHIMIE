# Optimisation de la geometrie de l'eau en Hartree-Fock / STO-3G
# Resultat attendu : E = -74,96590 hartree, O-H = 0,989 angstrom, H-O-H = 100,0 degres
&GLOBAL
  PROJECT EAUHF
  RUN_TYPE GEO_OPT
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    &SCF
      EPS_SCF 1.0E-7
      MAX_SCF 50
    &END SCF
    &XC
      &XC_FUNCTIONAL NONE
      &END XC_FUNCTIONAL
      &HF
        FRACTION 1.0
      &END HF
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC [angstrom] 10.0 10.0 10.0
      PERIODIC NONE
    &END CELL
    &COORD
      O 0.000000 0.000000 0.117790
      H 0.000000 0.755453 -0.471161
      H 0.000000 -0.755453 -0.471161
    &END COORD
    &KIND H
      BASIS_SET STO-3G
    &END KIND
    &KIND O
      BASIS_SET STO-3G
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
&MOTION
  &GEO_OPT
    OPTIMIZER BFGS
    MAX_ITER 50
  &END GEO_OPT
&END MOTION
