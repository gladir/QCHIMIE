# Demonstration du preprocesseur : @SET, @INCLUDE, @IF / @ELSE / @ENDIF et ${VARIABLE}
# Essayez : CP2K -E CHOIX=2 PREPROC.INP     ou     CP2K --echo PREPROC.INP
@INCLUDE 'PREPROC.INC'
@SET CHOIX 1
@SET PROJET EAUPRE
&GLOBAL
  PROJECT ${PROJET}
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    &SCF
      EPS_SCF ${EPS}
    &END SCF
    &XC
@IF ${CHOIX} == 1
      &XC_FUNCTIONAL NONE
      &END XC_FUNCTIONAL
      &HF
        FRACTION 1.0
      &END HF
@ELSE
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
@ENDIF
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC [angstrom] 10.0 10.0 10.0
      PERIODIC NONE
    &END CELL
    &COORD
      O 0.000000 0.000000 0.117790
      H 0.000000 0.755453 -0.471161
      H 0.000000 -0.755453 -0.471161
    &END COORD
    &KIND H
      BASIS_SET ${BASE}
    &END KIND
    &KIND O
      BASIS_SET ${BASE}
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
