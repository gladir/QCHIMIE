# Frequences de vibration de l'eau en Hartree-Fock / STO-3G (geometrie optimisee)
# Resultat attendu : 2170, 4140 et 4391 cm-1
&GLOBAL
  PROJECT EAUVIB
  RUN_TYPE VIBRATIONAL_ANALYSIS
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    &SCF
      EPS_SCF 1.0E-7
      MAX_SCF 50
    &END SCF
    &XC
      &XC_FUNCTIONAL NONE
      &END XC_FUNCTIONAL
      &HF
        FRACTION 1.0
      &END HF
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC [angstrom] 10.0 10.0 10.0
      PERIODIC NONE
    &END CELL
    &COORD
      O 0.000000000 0.000000000 0.149004865
      H 0.000000000 0.758078772 -0.486768301
      H 0.000000000 -0.758078772 -0.486768301
    &END COORD
    &KIND H
      BASIS_SET STO-3G
    &END KIND
    &KIND O
      BASIS_SET STO-3G
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
&VIBRATIONAL_ANALYSIS
  DX 0.01
&END VIBRATIONAL_ANALYSIS
