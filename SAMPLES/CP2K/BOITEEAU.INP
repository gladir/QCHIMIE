# Boite de 64 molecules d'eau flexibles (modele de type SPC/E), sommation d'Ewald
# Dynamique NVT avec le thermostat CSVR ; la boite de depart est un reseau desordonne
&GLOBAL
  PROJECT BOITEEAU
  RUN_TYPE MD
  PRINT_LEVEL LOW
  SEED 2000
&END GLOBAL
&FORCE_EVAL
  METHOD FIST
  &MM
    &FORCEFIELD
      &CHARGE
        ATOM OW
        CHARGE -0.8476
      &END CHARGE
      &CHARGE
        ATOM HW
        CHARGE 0.4238
      &END CHARGE
      &NONBONDED
        &LENNARD-JONES
          ATOMS OW OW
          EPSILON [kcalmol] 0.1553
          SIGMA [angstrom] 3.166
          RCUT [angstrom] 6.0
        &END LENNARD-JONES
        &LENNARD-JONES
          ATOMS OW HW
          EPSILON 0.0
          SIGMA [angstrom] 1.0
          RCUT [angstrom] 6.0
        &END LENNARD-JONES
        &LENNARD-JONES
          ATOMS HW HW
          EPSILON 0.0
          SIGMA [angstrom] 1.0
          RCUT [angstrom] 6.0
        &END LENNARD-JONES
      &END NONBONDED
      &BOND
        ATOMS OW HW
        KIND HARMONIC
        K [kcalmol*angstrom^-2] 1059.162
        R0 [angstrom] 1.0
      &END BOND
      &BEND
        ATOMS HW OW HW
        KIND HARMONIC
        K [kcalmol*rad^-2] 75.9
        THETA0 [deg] 109.47
      &END BEND
    &END FORCEFIELD
    &POISSON
      &EWALD
        EWALD_TYPE SPME
      &END EWALD
    &END POISSON
  &END MM
  &SUBSYS
    &CELL
      ABC [angstrom] 12.400 12.400 12.400
    &END CELL
    &TOPOLOGY
      CONN_FILE_FORMAT GENERATE
    &END TOPOLOGY
    &COORD
