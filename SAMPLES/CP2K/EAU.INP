# Molecule d'eau : energie et forces en DFT (PBE) avec la base 6-31G
# Les forces sont calculees par differences finies de l'energie
&GLOBAL
  PROJECT EAU
  RUN_TYPE ENERGY_FORCE
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    &QS
      METHOD GPW
    &END QS
    &SCF
      EPS_SCF 1.0E-6
      MAX_SCF 50
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC [angstrom] 10.0 10.0 10.0
      PERIODIC NONE
    &END CELL
    &COORD
      O 0.000000 0.000000 0.117790
      H 0.000000 0.755453 -0.471161
      H 0.000000 -0.755453 -0.471161
    &END COORD
    &KIND H
      BASIS_SET 6-31G
    &END KIND
    &KIND O
      BASIS_SET 6-31G
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
