# Argon liquide/solide : 32 atomes de Lennard-Jones dans une cellule periodique
# Energie et forces (FIST), avec le tenseur des contraintes
&GLOBAL
  PROJECT AR32
  RUN_TYPE ENERGY_FORCE
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD FIST
  &MM
    &FORCEFIELD
      &CHARGE
        ATOM Ar
        CHARGE 0.0
      &END CHARGE
      &NONBONDED
        &LENNARD-JONES
          ATOMS Ar Ar
          EPSILON [K_e] 119.8
          SIGMA [angstrom] 3.405
          RCUT [angstrom] 5.0
        &END LENNARD-JONES
      &END NONBONDED
    &END FORCEFIELD
    &POISSON
      &EWALD
        EWALD_TYPE NONE
      &END EWALD
    &END POISSON
  &END MM
  &SUBSYS
    &CELL
      ABC [angstrom] 10.5200 10.5200 10.5200
    &END CELL
    &COORD
      Ar -0.078611 0.013269 -0.039013
      Ar 2.661176 2.667716 -0.130341
